# ---- Server
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080          # the public https:// address in production (used in Tamara URLs)
LOG_LEVEL=info
CORS_ORIGINS=                             # comma-separated web origins (admin dashboard); mobile apps need none

# ---- Data
DATABASE_URL=postgres://xtreme:xtreme@localhost:5432/xtreme
REDIS_URL=                                # set when running more than one API instance

# ---- Secrets (generate each with: openssl rand -base64 48)
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-change-me

# ---- Phone sign-in (SMS)
SMS_PROVIDER=console                      # console (dev: codes print in the log) | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                              # an approved sender ID, or
TWILIO_MESSAGING_SERVICE_SID=
# App Store / Play reviewers sign in with this number and fixed code (no SMS sent)
OTP_REVIEW_PHONES=
OTP_REVIEW_CODE=

# ---- Social sign-in
GOOGLE_CLIENT_IDS=                        # iOS, Android and web OAuth client IDs, comma-separated
APPLE_BUNDLE_IDS=ae.xtremefm.app          # iOS bundle id (+ Services ID if web sign-in is added)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Payments (catalog prices are AED, VAT-inclusive)
VAT_RATE=0.05
APP_SCHEME=xtreme
STRIPE_SECRET_KEY=                        # sk_test_... / sk_live_...
STRIPE_PUBLISHABLE_KEY=                   # pk_test_... / pk_live_...
STRIPE_WEBHOOK_SECRET=                    # whsec_... for {PUBLIC_URL}/v1/webhooks/stripe
# Encrypts chat messages and profile photos in the database. Generate once: openssl rand -base64 32
# Keep a safe copy: if it is lost, encrypted chats and photos cannot be read. Never change it once set.
DATA_ENCRYPTION_KEY=
# Render deploy hook (service Settings > Deploy Hook) for the dashboard's "Deploy latest version" button
RENDER_DEPLOY_HOOK_URL=
# Network International N-Genius. When the key and outlet are set, card payments use N-Genius (not Stripe).
NGENIUS_API_URL=https://api-gateway.sandbox.ngenius-payments.com   # https://api-gateway.ngenius-payments.com live
NGENIUS_API_KEY=                          # Service account API key from the N-Genius portal
NGENIUS_OUTLET_REF=                       # Outlet reference (portal: Settings > Organisational hierarchy)
NGENIUS_WEBHOOK_SECRET=                   # value of header X-Webhook-Secret on webhook {PUBLIC_URL}/v1/webhooks/ngenius
TAMARA_API_URL=https://api-sandbox.tamara.co   # https://api.tamara.co in production
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_INSTALMENTS=4

# ---- Push notifications (Expo → APNs / FCM)
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# ---- First admin, created by `npm run db:seed`
ADMIN_PHONE=+971503641714

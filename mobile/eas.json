{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://xtreme-api-test.onrender.com"
      },
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "playtest": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://xtreme-api-test.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.xtreme-fmgroup.com"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826784890"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    },
    "playtest": {
      "extends": "production"
    }
  }
}
